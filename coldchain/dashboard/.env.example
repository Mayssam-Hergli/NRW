# Copy to .env for local dev. Vite only exposes vars prefixed VITE_ to the
# client bundle -- never put SUPABASE_SERVICE_KEY (or anything else secret)
# in a variable with this prefix, it will end up in the shipped JS.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key -- safe to ship, RLS is the real boundary>
